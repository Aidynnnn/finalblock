# Copy this file to .env and fill in your deployed contract addresses.

# ── Target Network ───────────────────────────────────────────────
# Sepolia (11155111) — matches the subgraph network config.
# Switch to Arbitrum Sepolia (421614) or Base Sepolia (84532) if
# you deploy to an L2 testnet instead.
VITE_CHAIN_ID=11155111

# ── Deployed Contract Addresses ─────────────────────────────────
VITE_AMM_ADDRESS=0x0000000000000000000000000000000000000000
VITE_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_GOVERNOR_ADDRESS=0x0000000000000000000000000000000000000000
VITE_GOV_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# ── The Graph Subgraph Endpoint ──────────────────────────────────
# Subgraph Studio query URL (replace {id} and {slug} after deploying):
#   https://api.studio.thegraph.com/query/{id}/bcht2-defi-subgraph/version/latest
# Or hosted service:
#   https://api.thegraph.com/subgraphs/name/{github-user}/bcht2-defi-subgraph
VITE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/0/bcht2-defi-subgraph/version/latest

# ── Optional RPC Override ────────────────────────────────────────
# Leave blank to use the public default RPC for the chosen chain.
VITE_RPC_URL=
